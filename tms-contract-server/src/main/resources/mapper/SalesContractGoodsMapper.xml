<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xtm.contract.mapper.SalesContractGoodsMapper">

    <select id="sumGoodsQuantityByContractId" resultType="com.xtm.contract.model.dto.GoodsQuantityDTO">
        SELECT
        sales_contract_id AS contractId,
        sum(ifnull(main_orders_quantity,0)) AS mainOrdersQuantity
        FROM sales_contract_goods
        WHERE sales_contract_id IN
        <foreach item="item" index="index" collection="contractIds" open="(" separator="," close=")">
            #{item}
        </foreach>
        and deleted = 0
        GROUP BY sales_contract_id
    </select>
</mapper>
